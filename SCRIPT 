Sub CariBinSAP()
    Dim SapGuiAuto As Object
    Dim SAPApp As Object
    Dim SAPConn As Object
    Dim SAPSession As Object
    
    Dim ws As Worksheet
    Dim lotID As String
    Dim barisTerakhir As Long ' Diperbaiki: spasi dihapus
    Dim binLocation As String
    Dim i As Long
    
    ' Menggunakan sheet yang sedang aktif agar tidak error "Subscript out of range"
    Set ws = ActiveSheet 
    
    ' 1. KONEKSI KE SAP YANG SEDANG TERBUKA
    On Error Resume Next
    Set SapGuiAuto = GetObject("SAPGUI")
    If SapGuiAuto Is Nothing Then
        MsgBox "Silakan buka SAP GUI terlebih dahulu!", vbCritical
        Exit Sub
    End If
    
    Set SAPApp = SapGuiAuto.GetScriptingEngine
    Set SAPConn = SAPApp.Children(0)
    Set SAPSession = SAPConn.Children(0)
    On Error GoTo 0
    
    ' 2. PROSES PENCARIAN DATA (LOOPING)
    barisTerakhir = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    
    For i = 2 To barisTerakhir
        lotID = Trim(ws.Cells(i, 1).Value)
        
        If lotID <> "" Then
            ' --- KODE SAP SCRIPTING START ---
            SAPSession.StartTransaction "LS24"
            
            SAPSession.findById("wnd[0]/usr/ctxtLGNUM").Text = "100"
            SAPSession.findById("wnd[0]/usr/ctxtMATNR").Text = lotID
            SAPSession.findById("wnd[0]/txtCHARG").Text = ""
            SAPSession.findById("wnd[0]/tbar[0]/btn[0]").press
            
            binLocation = SAPSession.findById("wnd[0]/usr/lbl[12,10]").Text 
            ' --- KODE SAP SCRIPTING END ---
            
            ws.Cells(i, 2).Value = binLocation
        End If
    Next i
    
    MsgBox "Pencarian selesai!", vbInformation
End Sub
