Sub Proses_ZWMP292_PerBatch()
    Dim SapGuiAuto As Object, SAPApp As Object, SAPConn As Object, SAPSession As Object
    Dim sapROT As Object
    Dim ws As Worksheet
    Dim lotID As String, batchID As String
    Dim barisTerakhir As Long, i As Long, suksesCount As Long
    Dim dictBatch As Object
    
    Set ws = ActiveSheet
    
    ' 1. Cek ketersediaan data di Kolom A (Mulai baris 5)
    barisTerakhir = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    If barisTerakhir < 5 Then
        MsgBox "Data Lot ID di kolom A (mulai baris 5) tidak ditemukan!", vbCritical, "Data Kosong"
        Exit Sub
    End If
    
    ' 2. Inisialisasi Koneksi ke SAP GUI yang sedang aktif
    On Error Resume Next
    Set SapGuiAuto = GetObject("SAPGUI")
    If SapGuiAuto Is Nothing Then
        Set sapROT = CreateObject("SapROTWr.SapROTWrapper")
        If Not sapROT Is Nothing Then
            Set SapGuiAuto = sapROT.GetROTEntry("SAPGUI")
        End If
    End If
    
    If SapGuiAuto Is Nothing Then
        MsgBox "SAP GUI belum terbuka atau Scripting belum aktif!", vbCritical, "Koneksi Gagal"
        Exit Sub
    End If
    
    Set SAPApp = SapGuiAuto.GetScriptingEngine
    Set SAPConn = SAPApp.Children(0)
    Set SAPSession = SAPConn.Children(0)
    On Error GoTo 0
    
    ' Dictionary untuk validasi unik Batch
    Set dictBatch = CreateObject("Scripting.Dictionary")
    suksesCount = 0
    
    On Error GoTo ErrorSAP
    
    ' 3. Looping Data
    For i = 5 To barisTerakhir
        lotID = Trim(ws.Cells(i, 1).Value)      ' Kolom A
        batchID = Trim(ws.Cells(i, 3).Value)    ' Kolom C
        
        If lotID <> "" Then
            ' Cek Syarat: Per Batch hanya boleh 1 kali Lot ID
            If batchID <> "" And dictBatch.exists(batchID) Then
                ws.Cells(i, 4).Value = "SKIPPED (DUPLICATE BATCH)"
            Else
                If batchID <> "" Then dictBatch.Add batchID, True
                
                ' --- STEP 1: INPUT LOT ID ---
                ' CATATAN: Ganti "txtGD_LOT" dengan ID input box Lot ID dari Record Anda
                SAPSession.findById("wnd[0]/usr/txtGV_ZLOTID").Text = lotID
                
                ' --- STEP 2: TEKAN ENTER ---
                SAPSession.findById("wnd[0]").sendVKey 0
                
                DoEvents
                Application.Wait (Now + TimeValue("00:00:01"))
                
                ' --- STEP 3: TEKAN TOMBOL CONFIRM ---
                ' CATATAN: Ganti ID tombol confirm sesuai hasil record (Contoh tombol F8 / Save / Button kustom)
                ' Opsi A: Jika tombol ada di toolbar/layar body:
                SAPSession.findById("wnd[0]/usr/btnCONFIRM").press
                
                ' Opsi B (Alternatif): Jika confirm menggunakan shortcut Function Key (misal F8 = 8, F11/Save = 11)
                ' SAPSession.findById("wnd[0]").sendVKey 8
                
                DoEvents
                Application.Wait (Now + TimeValue("00:00:01"))
                
                ' Tandai status sukses di Kolom D
                ws.Cells(i, 4).Value = "SUCCESS"
                suksesCount = suksesCount + 1
            End If
        End If
    Next i
    
    MsgBox "Proses ZWMP292 Selesai!" & vbCrLf & _
           "Total " & suksesCount & " Lot ID berhasil di-confirm.", vbInformation, "Selesai"
    Exit Sub

ErrorSAP:
    MsgBox "Terjadi kesalahan pada session SAP ZWMP292!" & vbCrLf & _
           "Pastikan Anda berada di layar menu ZWMP292 yang aktif dan ID tombol Confirm sudah sesuai.", vbCritical, "Error SAP"
End Sub

