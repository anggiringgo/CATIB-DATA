Sub Book_LokasiBin_ZWMP002()
    Dim SapGuiAuto As Object, SAPApp As Object, SAPConn As Object, SAPSession As Object
    Dim sapROT As Object
    Dim ws As Worksheet
    Dim targetBin As String, lotID As String, batchID As String
    Dim barisTerakhir As Long, i As Long, suksesCount As Long
    Dim dictBatch As Object
    
    ' Optimasi Performa Excel: Matikan Update Layar & Perhitungan Otomatis
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    Set ws = ActiveSheet ' Menggunakan sheet yang sedang aktif
    
    ' 1. POP-UP INPUT LOKASI BIN TUJUAN
    targetBin = InputBox("Masukkan Lokasi Storage Bin Tujuan:", "Input Lokasi Bin - ZWMP002")
    targetBin = Trim(targetBin)
    
    If targetBin = "" Then
        MsgBox "Proses dibatalkan: Lokasi Bin tidak boleh kosong!", vbExclamation, "Batal"
        GoTo ResetExcel
    End If
    
    ' 2. CEK DATA LOT ID DI KOLOM A (Mulai Baris 5)
    barisTerakhir = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    If barisTerakhir < 5 Then
        MsgBox "Data Lot ID di kolom A (mulai baris 5) tidak ditemukan!", vbCritical, "Data Kosong"
        GoTo ResetExcel
    End If
    
    ' 3. INISIALISASI KONEKSI KE SAP GUI
    On Error Resume Next
    Set SapGuiAuto = GetObject("SAPGUI")
    If SapGuiAuto Is Nothing Then
        Set sapROT = CreateObject("SapROTWr.SapROTWrapper")
        If Not sapROT Is Nothing Then
            Set SapGuiAuto = sapROT.GetROTEntry("SAPGUI")
        End If
    End If
    
    If SapGuiAuto Is Nothing Then
        MsgBox "SAP GUI belum terbuka atau Scripting belum aktif!", vbCritical, "Koneksi Gagal"
        GoTo ResetExcel
    End If
    
    Set SAPApp = SapGuiAuto.GetScriptingEngine
    Set SAPConn = SAPApp.Children(0)
    Set SAPSession = SAPConn.Children(0)
    On Error GoTo 0
    
    ' Inisialisasi Dictionary untuk memastikan 1 Batch hanya diproses 1 kali
    Set dictBatch = CreateObject("Scripting.Dictionary")
    suksesCount = 0
    
    On Error GoTo ErrorSAP
    
    ' 4. LOOPING PROSES INPUT (TANPA JEDA / Cepat)
    For i = 5 To barisTerakhir
        lotID = Trim(ws.Cells(i, 1).Value)      ' Kolom A
        batchID = Trim(ws.Cells(i, 3).Value)    ' Kolom C
        
        If lotID <> "" Then
            ' Pengecekan Syarat: Per Batch hanya boleh 1 kali Lot ID
            If batchID <> "" And dictBatch.exists(batchID) Then
                ' Jika Batch sudah pernah diinput sebelumnya, skip
                ws.Cells(i, 4).Value = "SKIPPED (DUPLICATE BATCH)"
            Else
                ' Catat batch ke dalam dictionary jika ada
                If batchID <> "" Then dictBatch.Add batchID, True
                
                ' --- STEP A: INPUT LOT ID LALU ENTER ---
                SAPSession.findById("wnd[0]/usr/txtG_QRCODE").Text = lotID
                SAPSession.findById("wnd[0]").sendVKey 0 ' Enter
                
                ' Tunggu SAP memproses (Instan, tanpa waktu tunggu mati)
                WaitSAP SAPSession
                
                ' --- STEP B: INPUT STORAGE BIN LALU ENTER ---
                SAPSession.findById("wnd[0]/usr/txtG_LGPLA").Text = targetBin
                SAPSession.findById("wnd[0]").sendVKey 0 ' Enter
                
                ' Tunggu SAP memproses
                WaitSAP SAPSession
                
                ' Tandai status di Kolom D
                ws.Cells(i, 4).Value = "SUCCESS (" & targetBin & ")"
                suksesCount = suksesCount + 1
            End If
        End If
    Next i
    
    ' Kembalikan Performa Excel ke Normal
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    
    MsgBox "Proses selesai!" & vbCrLf & _
           "Berhasil memproses: " & suksesCount & " Lot ID ke Bin: " & targetBin, vbInformation, "Selesai"
    Exit Sub

ErrorSAP:
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    MsgBox "Terjadi kesalahan pada session SAP ZWMP002!" & vbCrLf & _
           "Nomor Baris Excel: " & i & vbCrLf & _
           "Pastikan layar ZWMP002 sudah siap dan ID komponen kolom sudah sesuai.", vbCritical, "Error SAP"
    Exit Sub

ResetExcel:
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
End Sub

' Sub-routine untuk menunggu SAP secara dinamis (Cepat & Responsif)
Sub WaitSAP(Session As Object)
    Do While Session.Busy
        DoEvents
    Loop
End Sub

