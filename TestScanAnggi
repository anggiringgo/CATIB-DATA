Private Sub Worksheet_SelectionChange(ByVal Target As Range)
    Dim shp As Shape
    Dim areaKlik As Range
    
    Set areaKlik = Range("A2:A10")
    If Target.Cells.Count > 1 Then Exit Sub
    
    On Error Resume Next
    
    ' JIKA KLIK DI LUAR AREA TABEL / KLIK SEL KOSONG: Munculkan semua shape
    If Intersect(Target, areaKlik) Is Nothing Or Target.Value = "" Then
        For Each shp In ActiveSheet.Shapes
            If shp.Type = msoAutoShape Or shp.Type = msoFreeform Then
                shp.Visible = msoTrue
            End If
        Next shp
        Exit Sub
    End If
    
    ' JIKA KLIK DI DALAM AREA TABEL: Sembunyikan semua, lalu munculkan yang dipilih
    For Each shp In ActiveSheet.Shapes
        If shp.Type = msoAutoShape Or shp.Type = msoFreeform Then
            shp.Visible = msoFalse
        End If
    Next shp
    
    ActiveSheet.Shapes(Target.Value).Visible = msoTrue
    On Error GoTo 0
End Sub
