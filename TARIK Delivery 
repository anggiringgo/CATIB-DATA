Sub TarikData_Pilihan_DN_atau_ASN()
    Dim SapGuiAuto As Object, SAPApp As Object, SAPConn As Object, SAPSession As Object
    Dim sapROT As Object
    Dim grid As Object, gridDN As Object
    Dim ws As Worksheet
    Dim tipeInput As String, inputVal As String, asnNumber As String
    Dim totalBaris As Long, i As Long, rowExcel As Long
    
    Set ws = ActiveSheet
    
    ' 1. PILIH METODE INPUT (1 = Delivery Note, 2 = ASN)
    tipeInput = InputBox("Pilih Tipe Input:" & vbCrLf & _
                         "Ketik '1' untuk Delivery Note (DN)" & vbCrLf & _
                         "Ketik '2' untuk langsung ASN", "Pilih Tipe Input", "1")
    tipeInput = Trim(tipeInput)
    
    If tipeInput <> "1" And tipeInput <> "2" Then
        MsgBox "Proses dibatalkan: Pilihan harus 1 atau 2!", vbExclamation, "Batal"
        Exit Sub
    End If
    
    ' 2. INPUT NILAI BERDASARKAN PILIHAN
    If tipeInput = "1" Then
        inputVal = InputBox("Masukkan Nomor Delivery Note (DN):", "Input Delivery Note")
    Else
        inputVal = InputBox("Masukkan Nomor ASN:", "Input ASN")
    End If
    inputVal = Trim(inputVal)
    
    If inputVal = "" Then
        MsgBox "Proses dibatalkan: Nilai input tidak boleh kosong!", vbExclamation, "Batal"
        Exit Sub
    End If
    
    ' 3. INISIALISASI KONEKSI SAP GUI LOGON 770
    On Error Resume Next
    Set SapGuiAuto = GetObject("SAPGUI")
    If SapGuiAuto Is Nothing Then
        Set sapROT = CreateObject("SapROTWr.SapROTWrapper")
        If Not sapROT Is Nothing Then
            Set SapGuiAuto = sapROT.GetROTEntry("SAPGUI")
        End If
    End If
    
    If SapGuiAuto Is Nothing Then
        MsgBox "SAP GUI belum terbuka atau Scripting belum aktif!", vbCritical, "Koneksi Gagal"
        Exit Sub
    End If
    
    Set SAPApp = SapGuiAuto.GetScriptingEngine
    Set SAPConn = SAPApp.Children(0)
    Set SAPSession = SAPConn.Children(0)
    On Error GoTo 0
    
    On Error GoTo ErrorSAP
    
    ' 4. JIKA PILIHAN 1: AMBIL ASN DARI ZMM069A
    If tipeInput = "1" Then
        SAPSession.StartTransaction "ZMM069A"
        
        ' Mengisi Plant 3330 dan Delivery Note (Sesuaikan ID komponen field ZMM069A Anda)
        SAPSession.findById("wnd[0]/usr/ctxtS_WERKS-LOW").Text = "3330"
        SAPSession.findById("wnd[0]/usr/ctxtS_VBELN-LOW").Text = inputVal
        
        ' Tekan F8 (Execute)
        SAPSession.findById("wnd[0]/tbar[1]/btn[8]").press
        
        DoEvents
        Application.Wait (Now + TimeValue("00:00:02"))
        
        ' Ambil Nomor ASN dari hasil tabel/grid ZMM069A
        ' Opsi A: Jika ZMM069A berupa ALV Grid (baris pertama)
        Set gridDN = SAPSession.findById("wnd[0]/usr/cntlGRID1/shellcont/shell")
        asnNumber = Trim(gridDN.getCellValue(0, "ASN_NUM")) ' Ganti "ASN_NUM" dengan technical name kolom ASN
        
        ' Opsi B (Alternatif): Jika berupa field biasa di layar, gunakan findById text box:
        ' asnNumber = Trim(SAPSession.findById("wnd[0]/usr/txtGD_ASN").Text)
        
        If asnNumber = "" Then
            MsgBox "Nomor ASN tidak ditemukan untuk Delivery Note: " & inputVal, vbCritical, "ASN Kosong"
            Exit Sub
        End If
    Else
        ' Jika pilihan 2, nilai input langsung menjadi nomor ASN
        asnNumber = inputVal
    End If
    
    ' 5. JALANKAN TCODE ZWMR019 & FILTER PLANT 3330, STATUS 02
    SAPSession.StartTransaction "ZWMR019"
    
    SAPSession.findById("wnd[0]/usr/ctxtS_WERKS-LOW").Text = "3330"
    SAPSession.findById("wnd[0]/usr/ctxtS_STATUS-LOW").Text = "02"
    
    ' Tekan F8 (Execute)
    SAPSession.findById("wnd[0]/tbar[1]/btn[8]").press
    
    DoEvents
    Application.Wait (Now + TimeValue("00:00:02"))
    
    ' 6. FILTER ALV GRID BERDASARKAN ASN
    Set grid = SAPSession.findById("wnd[0]/usr/cntlGRID1/shellcont/shell")
    grid.selectColumn "VBELN" ' Sesuaikan technical name kolom Delivery/ASN
    grid.pressToolbarButton "&MB_FILTER"
    
    SAPSession.findById("wnd[1]/usr/ssub%_SUBSCREEN_FREESEL:SAPLSSEL:1105/ctxt%%DYN001-LOW").Text = asnNumber
    SAPSession.findById("wnd[1]/tbar[0]/btn[0]").press ' Tekan Enter / Confirm Filter
    
    DoEvents
    Application.Wait (Now + TimeValue("00:00:01"))
    
    ' 7. TARIK DATA KE EXCEL
    ws.Range("A1:D1").Value = Array("Lot ID", "Batch", "Material Number", "Remaining Quantity")
    ws.Range("A1:D1").Font.Bold = True
    ws.Range("A2:D" & ws.Rows.Count).ClearContents
    
    totalBaris = grid.RowCount
    
    If totalBaris = 0 Then
        MsgBox "Tidak ada data ditemukan untuk ASN: " & asnNumber, vbInformation, "Data Kosong"
        Exit Sub
    End If
    
    rowExcel = 2
    For i = 0 To totalBaris - 1
        ws.Cells(rowExcel, 1).Value = grid.getCellValue(i, "CHARG_LOT") ' Lot ID
        ws.Cells(rowExcel, 2).Value = grid.getCellValue(i, "CHARG")     ' Batch
        ws.Cells(rowExcel, 3).Value = grid.getCellValue(i, "MATNR")     ' Material Number
        ws.Cells(rowExcel, 4).Value = grid.getCellValue(i, "MENGE")     ' Remaining Qty
        
        rowExcel = rowExcel + 1
    Next i
    
    MsgBox "Selesai! Berhasil menarik " & totalBaris & " baris data (ASN: " & asnNumber & ")", vbInformation, "Sukses"
    Exit Sub

ErrorSAP:
    MsgBox "Terjadi kesalahan saat memproses data SAP!" & vbCrLf & _
           "Pastikan field Plant, Delivery, atau nama kolom ALV sudah sesuai hasil recording.", vbCritical, "Error SAP"
End Sub
